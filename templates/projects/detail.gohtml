{{ template "header" . }}
<main class="detail-page">
    <article>
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{{ .Project.Name }}</span></nav>
        <header class="detail-lead">
            <h1 class="page-title">{{ .Project.Name }}</h1>
            <p class="page-intro">{{ .Project.Tagline }}</p>
            <div class="detail-actions">
                <a class="primary" href="{{ .Project.RepoURL }}">GitHub</a>
                {{ if .Project.LiveURL }}<a href="{{ .Project.LiveURL }}">Live site</a>{{ end }}
            </div>
        </header>
        <div class="detail-body">
            <section class="project-copy" aria-labelledby="overview-title">
                <h2 id="overview-title">What it does</h2>
                {{ range .Project.Paragraphs }}<p>{{ . }}</p>{{ end }}
                <h2>Stack notes</h2>
                <ul class="tech-list" aria-label="{{ .Project.Name }} technology">{{ range .Project.Tech }}<li>{{ . }}</li>{{ end }}</ul>
                <h2>Highlights</h2>
                <ul class="highlight-list">{{ range .Project.Highlights }}<li>{{ . }}</li>{{ end }}</ul>
            </section>
            <aside aria-label="Project metadata">
                <dl class="metadata-list">
                    <div><dt>Last Update</dt><dd>{{ .Project.LastUpdate }}</dd></div>
                    <div><dt>Notes</dt><dd>{{ .Project.Notes }}</dd></div>
                </dl>
            </aside>
        </div>
        <section class="screenshot-section" aria-labelledby="screenshots-title">
            <h2 id="screenshots-title">Screenshots</h2>
            <div class="screenshot-grid">
                {{ range .Project.Screenshots }}
                <figure class="screenshot-frame">
                    {{ if .Path }}
                    <a href="{{ .Path }}"><img src="{{ .Path }}" alt="{{ .Alt }}" loading="lazy"></a>
                    <p class="screenshot-note">{{ .Note }}</p>
                    {{ else }}
                    <div class="screenshot-placeholder"><span>Capture pending</span><p>{{ .Note }}</p></div>
                    {{ end }}
                    <figcaption>{{ .Title }}</figcaption>
                </figure>
                {{ end }}
            </div>
        </section>
        <a class="all-projects" href="/projects">All projects</a>
    </article>
</main>
{{ template "footer" }}
