{{ template "header" . }}
<main class="projects-page">
    <h1 class="page-title">Selected personal projects</h1>
    <p class="page-intro">A compact list of recent applications and the site itself.</p>
    <section class="project-list" aria-label="Projects">
        {{ range .Projects }}
        <article class="project-entry">
            <div>
                <h2><a href="/projects/{{ .Slug }}">{{ .Name }}</a></h2>
                <p class="updated">Updated: {{ .LastUpdate }}</p>
            </div>
            <div>
                <p>{{ .Summary }}</p>
                <ul class="tech-list" aria-label="{{ .Name }} technology">
                    {{ range .Tech }}<li>{{ . }}</li>{{ end }}
                </ul>
                <a class="project-link" href="/projects/{{ .Slug }}" aria-label="{{ .Name }} details">Details</a>
            </div>
        </article>
        {{ end }}
    </section>
</main>
{{ template "footer" }}
