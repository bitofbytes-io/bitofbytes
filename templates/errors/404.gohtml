{{ template "header" . }}
<main class="nc-wrap">
    <section class="nc-page-head">
        <div class="nc-page-head__titles">
            <p class="nc-eyebrow">404 · Not found</p>
            <h1 class="nc-heading nc-heading--page">Page not <span class="nc-em">found</span></h1>
            <p class="nc-intro">That page does not exist, or it has moved. Try one of these instead.</p>
            <div class="nc-actions">
                <a class="nc-btn nc-btn--primary" href="/">Home</a>
                <a class="nc-btn nc-btn--secondary" href="/projects">Projects</a>
                <a class="nc-btn nc-btn--secondary" href="/updates">Updates</a>
            </div>
        </div>
    </section>
</main>
{{ template "footer" }}
