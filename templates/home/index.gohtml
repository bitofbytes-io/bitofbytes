{{ template "header" . }}
<main>
  <section class="home-page" aria-label="About Daniel">
   <div class="hardware-hero">
    <div class="hardware-bio"><h1 aria-label="Daniel Waters">Daniel<br>Waters.</h1><p class="reading">I'm a Senior Software Engineer at Cisco, working on live video and real-time collaboration.</p><p class="reading">Outside work, I play piano and build small apps for everyday life. And yes, I still love a good handheld.</p><div class="hardware-actions"><a class="primary" href="/projects">View my projects</a><a href="/static/daniel-resume-2024.pdf" target="_blank" rel="noreferrer">My resume</a></div><address id="contact" class="contact-block" style="font-style:normal"><a class="contact-email" href="mailto:daniel@bitofbytes.io">daniel@bitofbytes.io</a><div class="contact-socials"><a href="https://www.linkedin.com/in/daniel-waters/">LinkedIn</a><a href="https://github.com/bitofbytes-io">GitHub</a></div></address><p class="hardware-location">Raleigh, North Carolina</p></div>
    <div class="model-column"><div class="scene-slot" data-scene="atomic" aria-label="Interactive clear handheld"><div class="fallback-device" aria-hidden="true"><div class="fallback-display">Daniel<br>Waters<small>Software engineer</small></div><div class="fallback-controls"><span>✚</span><span>B &nbsp; A</span></div></div></div><div class="device-control-row" role="group" aria-label="Browse and open the handheld screen"><button class="screen-prev" disabled aria-label="Previous screen">‹</button><a class="device-status" href="/projects" aria-label="View all projects" aria-live="polite">About Daniel</a><button class="screen-next" disabled aria-label="Next screen">›</button></div><p class="engine-message" hidden></p></div>
   </div>
  </section>
<div hidden id="handheld-projects">{{ range .Projects }}<span data-slug="{{ .Slug }}" data-name="{{ .Name }}" data-summary="{{ .Summary }}"></span>{{ end }}</div>
</main>
{{ template "footer" }}
