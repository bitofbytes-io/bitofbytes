{{ template "header" . }}
<main>
    <section class="nc-wrap nc-home-hero" aria-label="About Daniel">
        <p class="nc-eyebrow">Daniel Waters · Senior Software Engineer · Raleigh, NC</p>
        <h1 class="nc-heading nc-heading--hero">Real-time video at work.<br><span class="nc-em">Small apps</span> at home.</h1>
        <p class="nc-lead">I build live video and real-time collaboration software at Cisco. After hours I play piano, lose evenings to videogames, and write small apps for everyday life. {{ .KeyCount }} of them live below, one per key.</p>
        <div class="nc-actions">
            <a class="nc-btn nc-btn--primary" href="/projects">See the projects
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
            <a class="nc-btn nc-btn--secondary" href="/static/daniel-waters-resume.pdf">Resume (PDF)</a>
        </div>
    </section>

    <section class="nc-wrap nc-octave-section" aria-label="{{ .KeyCount }} side projects, one octave">
        <div class="nc-octave nc-octave--keys-{{ len .Keys }}" data-nc-octave>
            <div class="nc-octave__keys">
                {{ range .Keys }}
                <a class="nc-key{{ if .Recent }} nc-key--lit{{ end }}" href="/projects/{{ .Slug }}" data-note="{{ .Note }}">
                    <span class="nc-key__name">{{ .Name }}</span>
                    <span class="nc-key__since">{{ .StartedKey }}</span>
                </a>
                {{ end }}
            </div>
            {{ range .BlackKeys }}<div class="nc-black nc-black--pos-{{ .Pos }}" aria-hidden="true"></div>{{ end }}
        </div>
        <div class="nc-octave__caption">
            <p class="nc-legend">
                <span>{{ .KeyCount }} side projects, one octave. <span class="nc-desktop-only">Left to right</span><span class="nc-phone-only">Top to bottom</span> in the order I started them.</span>
                <span class="nc-legend__item"><span class="nc-legend__swatch nc-legend__swatch--lit" aria-hidden="true"></span>updated in the last 30 days</span>
                <span class="nc-legend__item"><span class="nc-legend__swatch" aria-hidden="true"></span>resting</span>
            </p>
            <button type="button" class="nc-sound" data-nc-sound aria-pressed="true">
                <svg class="nc-sound__on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4V5z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path></svg>
                <svg class="nc-sound__off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4V5z"></path><path d="M16 9l5 6M21 9l-5 6"></path></svg>
                <span><span class="nc-desktop-only">Hover to play · </span><span class="nc-phone-only">Tap to play · </span><span data-nc-sound-label>Sound on</span></span>
            </button>
        </div>
    </section>

    <section class="nc-wrap nc-section" aria-labelledby="latest-title">
        <div class="nc-section__titles">
            <p class="nc-eyebrow">Changelog{{ if .RecentCount }} · {{ .RecentLabel }} in the last 30 days{{ end }}</p>
            <h2 class="nc-heading nc-heading--section" id="latest-title">Latest <span class="nc-em">updates.</span></h2>
        </div>
        <div class="nc-latest">
            {{ if .HasFeatured }}{{ with .Featured }}
            <a class="nc-featured" href="/projects/{{ .Slug }}">
                <img class="nc-featured__shot" src="{{ .Thumbnail.Path }}" alt="{{ .Thumbnail.Alt }}" width="520" height="390" loading="lazy">
                <span class="nc-featured__meta">
                    <span class="nc-featured__head"><span class="nc-featured__name">{{ .Name }}</span><span class="nc-featured__date">{{ .UpdatedShort }}</span></span>
                    <span class="nc-featured__tagline">{{ .Tagline }}</span>
                    <span class="nc-featured__note">{{ .LatestNote }}</span>
                </span>
            </a>
            {{ end }}{{ end }}
            <div class="nc-ledger">
                {{ range .Updates }}
                <a class="nc-ledger__row" href="/projects/{{ .Slug }}">
                    <span class="nc-ledger__date">{{ .UpdatedShort }}</span>
                    <span class="nc-ledger__body"><span class="nc-ledger__name">{{ .Name }}</span><span class="nc-ledger__note">{{ .LatestNote }}</span></span>
                </a>
                {{ end }}
            </div>
        </div>
    </section>

    <section class="nc-band" aria-labelledby="hobbies-title">
        <div class="nc-wrap nc-band__inner">
            <h2 class="nc-heading nc-heading--section" id="hobbies-title">Off the clock, <span class="nc-em">mostly keys.</span></h2>
            <div class="nc-now">
                <div class="nc-now__item">
                    <span class="nc-now__label">Programming{{ with .Activities.Building }} · building now{{ end }}</span>
                    {{ with .Activities.Building }}<span class="nc-now__value">{{ . }}</span>{{ end }}
                    <p class="nc-now__copy">Real-time video at work; small, private apps at home. Mostly Go and PostgreSQL, each one scratching a household itch.</p>
                </div>
                <div class="nc-now__item">
                    <span class="nc-now__label">Piano{{ with .Activities.Practicing }} · on the stand{{ end }}</span>
                    {{ with .Activities.Practicing }}<span class="nc-now__value">{{ . }}</span>{{ end }}
                    <p class="nc-now__copy">My sheet music lives on an iPad on the music stand, which is exactly why <a class="nc-prose-link" href="/projects/noted">Noted</a> exists.</p>
                </div>
                <div class="nc-now__item">
                    <span class="nc-now__label">Videogames{{ with .Activities.Playing }} · playing{{ end }}</span>
                    {{ with .Activities.Playing }}<span class="nc-now__value">{{ . }}</span>{{ end }}
                    <p class="nc-now__copy">Still love a good handheld. The game shelf is catalogued in <a class="nc-prose-link" href="/projects/anthology">Anthology</a>, right beside the books, movies and music.</p>
                </div>
            </div>
        </div>
    </section>
</main>
{{ template "footer" }}
