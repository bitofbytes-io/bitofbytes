{{ define "header" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BitOfBytes | Daniel Waters</title>
    <link rel="stylesheet" href="/static/styles.css">
    <link rel="icon" href="/static/favicon.ico?v=20260905" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg?v=20260905">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png?v=20260905">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png?v=20260905">
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png?v=20260905">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;500;700&family=VT323&display=swap" rel="stylesheet">
</head>
<body id="dw-atomic" data-design="atomic" data-route="{{ category }}">
<div class="portfolio">
<header class="site-nav">
    <a class="brand" href="/">bitofbytes</a>
    <nav class="nav-links" aria-label="Main navigation">
        <a href="/"{{ if eq category "home" }} aria-current="page"{{ end }}>Home</a>
        <a href="/projects"{{ if eq category "projects" }} aria-current="page"{{ end }}>Projects</a>
    </nav>
</header>
{{ end }}
{{ define "footer" }}
</div>
{{ if eq category "home" }}<script type="module" src="/static/atomic-handheld.js"></script>{{ end }}
<script defer src="/static/umami-loader.js"></script>
</body>
</html>
{{ end }}
