# For local development copy this file to `.env` and set values as needed.
# Production containers receive configuration from environment variables
# instead of reading this file directly.

# Set true behind production HTTPS and false for local HTTP (required)
CSRF_SECURE=

# Server Config
SERVER_ADDRESS=

# Internal Prometheus /metrics listener. Defaults to :9464 when unset; set off to disable.
METRICS_ADDR=

# Logging
# LOG_LEVEL accepts debug, info, warn, or error. Defaults to info when unset (Docker images default to warn).
LOG_LEVEL=info
# LOG_FORMAT accepts text or json. Defaults to text when unset.
LOG_FORMAT=text
